# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_SOCIAL=social-images

# Exa API (https://exa.ai)
EXA_API_KEY=

# Instantly API (https://instantly.ai)
INSTANTLY_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenRouter (video generation)
OPENROUTER_API_KEY=
# Switch socials media mode: image | video
SOCIAL_MEDIA_ASSET_MODE=image
# Video model switch when SOCIAL_MEDIA_ASSET_MODE=video:
# - google/veo-3.1-fast
# - bytedance/seedance-2.0-fast
OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast

# Postiz (https://docs.postiz.com/public-api/introduction)
POSTIZ_API_KEY=
POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# Inngest (https://inngest.com)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Resend (https://resend.com) - for daily digest emails
RESEND_API_KEY=

# Daily digest email settings
DIGEST_FROM_EMAIL=autogtm <noreply@yourdomain.com>
DIGEST_RECIPIENTS=you@example.com

# Contact form (Request cloud access) - where to receive submissions
CONTACT_FORM_TO=

# Invite codes (comma-separated) - users need one of these to sign up
INVITE_CODES=AUTOGTM

# App URL (used in digest email links)
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Google OAuth (optional - get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Redis (optional - for rate limiting)
REDIS_URL=
